# ============================================================
# Digital Code Vault — Production Environment Variables
# ============================================================
# Copy this file to .env.production and fill in real values.
# Do NOT commit real secrets to git.
# ============================================================

# ─── REQUIRED (Render Backend) ───

# PostgreSQL connection string from Render or external provider
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Redis connection string from Render or external provider
REDIS_URL="redis://HOST:6379"

# 64 hex characters (32 bytes) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="<GENERATE_64_HEX_CHARS>"

# Strong random strings — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="<STRONG_RANDOM_SECRET>"
JWT_REFRESH_SECRET="<DIFFERENT_STRONG_RANDOM_SECRET>"

# Must be "production" on Render
NODE_ENV="production"

# Port Render assigns (use their PORT env var, or 3000)
PORT=3000

# Production API URL (backend domain)
APP_URL="https://api.yourdomain.com"

# Comma-separated list of allowed CORS origins (frontend domains)
CORS_ORIGIN="https://yourdomain.com"

# Admin bootstrap — creates initial admin user on first startup
ADMIN_BOOTSTRAP_EMAIL="admin@yourdomain.com"
ADMIN_BOOTSTRAP_PASSWORD="<STRONG_ADMIN_PASSWORD>"
ADMIN_BOOTSTRAP_NAME="Super Admin"

# Email provider: "sendgrid" or "resend"
EMAIL_PROVIDER="sendgrid"

# SendGrid (required if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY="<YOUR_SENDGRID_API_KEY>"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="Your Brand"

# Resend (required if EMAIL_PROVIDER=resend)
# RESEND_API_KEY="<YOUR_RESEND_API_KEY>"
# RESEND_FROM_EMAIL="onboarding@resend.dev"

# ─── OPTIONAL (Render Backend) ───

# JWT token expiration (default: 15m)
# JWT_EXPIRES_IN="15m"

# JWT refresh token expiration (default: 7d)
# JWT_REFRESH_EXPIRES_IN="7d"

# Rate limiting per API key per minute (default: 120)
# RATE_LIMIT_PER_MINUTE=120

# HMAC timestamp window in milliseconds (default: 300000 = 5 min)
# HMAC_TIMESTAMP_WINDOW_MS=300000

# Idempotency key TTL in milliseconds (default: 86400000 = 24h)
# IDEMPOTENCY_KEY_TTL_MS=86400000

# Webhook max retries (default: 8)
# WEBHOOK_MAX_RETRIES=8

# ─── DISABLED — Stripe (leave empty) ───

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# ─── Vercel Frontend (if same domain, no env vars needed) ───
# The frontend uses relative /api/v1 paths.
# If frontend is on a separate domain, set up a rewrite/proxy.
# No VITE_* variables are currently used by the frontend.
