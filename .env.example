# Database
DATABASE_URL="postgresql://vault:vaultpass@localhost:5432/digitalcode?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Encryption - AES-256-GCM master key (32 bytes hex encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# JWT
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API
API_PREFIX="/api/v1"
HMAC_TIMESTAMP_WINDOW_MS=300000
IDEMPOTENCY_KEY_TTL_MS=86400000
IDEMPOTENCY_KEY_TTL_HOURS=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_MINUTE_IP=60

# Delivery Tokens (permanent — links never expire)
RESERVATION_TTL_MINUTES=15

# Webhook
WEBHOOK_MAX_RETRIES=8
WEBHOOK_RETRY_DELAY_MS=5000
WEBHOOK_MAX_DURATION_HOURS=24

# App
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Admin Bootstrap (initial super admin)
ADMIN_BOOTSTRAP_EMAIL="admin@digitalcode.local"
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME="Super Admin"

# Email Provider — choose: "resend" or "sendgrid"
EMAIL_PROVIDER="resend"

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Code Vault <noreply@digitalcode.local>"
FROM_EMAIL="noreply@digitalcode.local"

# Email (SendGrid) — used when EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@digitalcode.local"
SENDGRID_FROM_NAME="CodeHub"

# App URL (for generating delivery links)
APP_URL="http://localhost:3000"
