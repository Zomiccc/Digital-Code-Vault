# ─── Database ───
# Dev:  file:./dev.db (SQLite — auto-detected by prisma/set-provider.js)
# Prod: PostgreSQL connection string (auto-detected by prisma/set-provider.js)
DATABASE_URL="file:./dev.db"

# ─── Redis ───
# Required in production. In dev, omit to use in-memory fallback.
REDIS_URL="redis://localhost:6379"

# ─── Encryption ───
# AES-256-GCM master key (32 bytes hex encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ─── JWT ───
# REQUIRED in production. Use strong random strings.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── API ───
API_PREFIX="/api/v1"
HMAC_TIMESTAMP_WINDOW_MS=300000
IDEMPOTENCY_KEY_TTL_MS=86400000
IDEMPOTENCY_KEY_TTL_HOURS=24

# ─── Rate Limiting ───
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_MINUTE_IP=60

# ─── Delivery Tokens (permanent — links never expire) ───
RESERVATION_TTL_MINUTES=15

# ─── Webhook ───
WEBHOOK_MAX_RETRIES=8
WEBHOOK_RETRY_DELAY_MS=5000
WEBHOOK_MAX_DURATION_HOURS=24

# ─── App / Environment ───
NODE_ENV="development"
PORT=3000

# ─── URLs ───
# FRONTEND_URL: The public URL where the unified frontend is served (Vercel).
# API_URL:      The public URL where the API is served (Render).
# APP_URL:      Used internally for delivery/reveal links. Must equal API_URL.
#
# In development:
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000"
#
# In production (example):
# APP_URL="https://api.yourdomain.com"
# FRONTEND_URL="https://yourdomain.com"
# API_URL="https://api.yourdomain.com"

# ─── CORS ───
# Comma-separated list of allowed origins.
# In development: wildcard is allowed.
# In production: MUST be set to actual domain(s). No wildcard, no localhost.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# ─── Admin Bootstrap ───
# Initial super admin credentials (created on first startup if no admin exists)
ADMIN_BOOTSTRAP_EMAIL="admin@digitalcode.local"
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME="Super Admin"

# ─── Email Provider ───
# Choose: "resend" or "sendgrid"
EMAIL_PROVIDER="resend"

# ─── Email (Resend) ───
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Code Vault <noreply@digitalcode.local>"
FROM_EMAIL="noreply@digitalcode.local"

# ─── Email (SendGrid) ───
# Used when EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@digitalcode.local"
SENDGRID_FROM_NAME="CodeHub"

# ─── Stripe (DISABLED) ───
# Leave all Stripe keys empty to keep Stripe disabled.
# Stripe code remains in the codebase but will return "Stripe is not configured" errors.
# When enabling Stripe later, set these to real Stripe keys and ensure APP_URL is production URL.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
