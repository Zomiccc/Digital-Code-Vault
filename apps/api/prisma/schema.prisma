generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("SUPPORT")
  twoFactorSecret String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Merchant {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  address       String?
  status        String         @default("ACTIVE")
  walletBalance Decimal         @default(0)
  currency      String         @default("USD")
  allowedProductIds String     @default("[]")
  twoFactorRequired Boolean    @default(false)
  totalKeysGenerated Int        @default(0)
  lastKeyGeneratedAt DateTime?
  webhookSecret  String?        @unique
  // ─── Registration / KYC info ───
  firstName      String?
  lastName       String?
  phone          String?
  idDocType      String?        // CNIC | PASSPORT | LICENSE
  idFrontImage   String?        // base64 data-URL
  idBackImage    String?        // base64 data-URL
  businessNtn    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  users           MerchantUser[]
  apiKeys         ApiKey[]
  fulfillmentReqs FulfillmentRequest[]
  walletTxns      WalletTransaction[]
  webhookEndpoints WebhookEndpoint[]
  products        Product[]
  connectedProducts ConnectedProduct[]
  codeItems       CodeItem[]
  fundingRequests FundingRequest[]
  supportMessages SupportMessage[]
}

model MerchantUser {
  id           String   @id @default(uuid())
  merchantId   String
  email        String   @unique
  name         String
  passwordHash String
  twoFactorSecret String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model ApiKey {
  id           String       @id @default(uuid())
  merchantId   String
  keyPrefix    String
  keyHash      String
  scopes       String       @default("[]")
  ipWhitelist  String       @default("[]")
  status       String       @default("ACTIVE")
  lastUsedAt   DateTime?
  createdAt    DateTime     @default(now())
  revokedAt    DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([keyHash])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactInfo String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  Product[]
  codeItems CodeItem[]
  codeBatches CodeBatch[]
}

// Top of the catalog hierarchy: BRAND → CATEGORY → PRODUCT → VARIANT
// e.g. Brand "PlayStation" → Category "PSN Gift Card" → Product (per-region) →
// Variant (region / denomination / plan / duration).
model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories Category[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  brandId     String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([brandId])
}

model Region {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  currency  String   @default("USD")
  symbol    String   @default("$")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productRegions ProductRegion[]
}

model ProductRegion {
  id        String   @id @default(uuid())
  productId String
  regionId  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  region    Region  @relation(fields: [regionId], references: [id], onDelete: Cascade)
  variants  Variant[]

  @@unique([productId, regionId])
  @@index([productId])
  @@index([regionId])
}

model Variant {
  id             String   @id @default(uuid())
  productRegionId String
  name           String
  slug           String
  description    String?
  customerPrice  Decimal
  currency       String   @default("USD")
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productRegion   ProductRegion          @relation(fields: [productRegionId], references: [id], onDelete: Cascade)
  combinations    FulfillmentCombination[]

  @@unique([productRegionId, slug])
  @@index([productRegionId])
}

model FulfillmentCombination {
  id          String   @id @default(uuid())
  variantId   String
  name        String
  priority    Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variant    Variant                     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  items      FulfillmentCombinationItem[]

  @@index([variantId, active, priority])
}

model FulfillmentCombinationItem {
  id             String   @id @default(uuid())
  combinationId  String
  denominationId String
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  combination  FulfillmentCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  denomination Denomination @relation(fields: [denominationId], references: [id], onDelete: Cascade)

  @@index([combinationId])
  @@index([denominationId])
}

model Product {
  id         String   @id @default(uuid())
  name       String
  region     String
  productType String  @default("NORMAL") // NORMAL | ESSENTIALS
  categoryId String?
  supplierId String?
  merchantId String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  merchant      Merchant?      @relation(fields: [merchantId], references: [id])
  denominations Denomination[]
  fulfillmentReqs FulfillmentRequest[]
  connectedProducts ConnectedProduct[] @relation("ConnectedProductDcvProduct")
  productRegions ProductRegion[]
  essentialsDeliveryItems EssentialsDeliveryItem[]

  @@index([merchantId])
  @@index([categoryId])
}

// Essentials delivery rule: a reusable, denomination-based fulfillment configuration.
// The admin defines WHICH denominations and HOW MANY of each are required — e.g.
// "$10 x1 + $20 x1". At purchase time, the system automatically selects ANY available
// code(s) matching each required denomination — the admin never picks individual codes.
model EssentialsDeliveryItem {
  id             String   @id @default(uuid())
  productId      String
  denominationId String
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  denomination Denomination @relation(fields: [denominationId], references: [id], onDelete: Cascade)

  @@unique([productId, denominationId])
  @@index([productId])
}

model Denomination {
  id         String   @id @default(uuid())
  productId  String
  faceValue  Decimal
  currency   String   @default("USD")
  createdAt  DateTime @default(now())

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  codeItems CodeItem[]
  combinationItems FulfillmentCombinationItem[]
  essentialsDeliveryItems EssentialsDeliveryItem[]
  codeBatches CodeBatch[]

  @@unique([productId, faceValue, currency])
  @@index([productId])
}

model CodeItem {
  id              String      @id @default(uuid())
  denominationId  String
  encryptedCode   String
  codeHash        String
  status          String  @default("AVAILABLE")
  batchId         String?
  supplierId      String?
  merchantId      String?
  source          String  @default("DCV")
  reservedUntil   DateTime?
  reservedByReqId String?
  revealedAt      DateTime?
  revealedIp      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  denomination Denomination @relation(fields: [denominationId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  merchant     Merchant?    @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([denominationId, status])
  @@index([status])
  @@index([codeHash])
  @@index([batchId])
  @@index([merchantId])
  @@index([denominationId, status, merchantId])
}

model FulfillmentRequest {
  id              String             @id @default(uuid())
  merchantId      String
  productId       String
  amount          Decimal            @default(0)
  currency        String             @default("USD")
  idempotencyKey  String
  referenceId     String?
  status          String             @default("PENDING")
  failureReason   String?
  sandbox         Boolean            @default(false)
  customerEmail   String?
  customerName    String?
  customerAddress String?
  inventorySource String?            @default("DCV")
  walletCharged   Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  merchant        Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product         Product            @relation(fields: [productId], references: [id])
  allocations     Allocation[]
  deliveryToken   DeliveryToken?
  walletTxn       WalletTransaction?

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId])
  @@index([status])
  @@index([productId])
  @@index([customerEmail])
}

model Allocation {
  id              String   @id @default(uuid())
  fulfillmentId   String
  codeItemIds     String   @default("[]")
  status          String   @default("ALLOCATED")
  createdAt       DateTime @default(now())

  fulfillment FulfillmentRequest @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId])
}

model DeliveryToken {
  id            String    @id @default(uuid())
  fulfillmentId String    @unique
  tokenHash     String    @unique
  revealedAt    DateTime?
  revealedIp    String?
  createdAt     DateTime  @default(now())

  fulfillment FulfillmentRequest @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

model WalletTransaction {
  id            String        @id @default(uuid())
  merchantId    String
  type          String
  amount        Decimal
  balanceAfter  Decimal
  referenceId   String?
  fulfillmentId String?       @unique
  createdAt     DateTime      @default(now())

  merchant    Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  fulfillment FulfillmentRequest? @relation(fields: [fulfillmentId], references: [id])

  @@index([merchantId])
  @@index([referenceId])
}

model WebhookEndpoint {
  id         String   @id @default(uuid())
  merchantId String
  url        String
  secret     String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model AuditLog {
  id        String     @id @default(uuid())
  actorType String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ip        String?
  prevHash  String?
  entryHash String?
  createdAt DateTime   @default(now())

  @@index([actorType, actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model IdempotencyRecord {
  id              String   @id @default(uuid())
  key             String   @unique
  merchantId      String
  requestBodyHash String
  responseStatus  Int
  responseBody    String
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([merchantId, key])
  @@index([expiresAt])
}

model Customer {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  isActive     Boolean  @default(true)
  merchantId   String?
  merchantAppStatus String? // PENDING | APPROVED | REJECTED
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  verificationCode VerificationCode?
  merchantApplication MerchantApplication?

  @@index([merchantId])
  @@index([merchantAppStatus])
}

model MerchantApplication {
  id            String   @id @default(uuid())
  customerId    String   @unique
  storeName     String
  storeEmail    String
  currency      String   @default("USD")
  // ─── KYC details submitted with the application ───
  firstName     String?
  lastName      String?
  phone         String?
  idDocType     String?  // CNIC | PASSPORT | LICENSE
  idFrontImage  String?  // base64 data-URL
  idBackImage   String?  // base64 data-URL
  businessNtn   String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote     String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model VerificationCode {
  id        String   @id @default(uuid())
  customerId String  @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model EmailLog {
  id              String   @id @default(uuid())
  merchantId      String?
  recipient       String
  subject         String
  template        String?
  status          String   @default("PENDING")
  providerResponse String?
  errorMessage    String?
  retryCount      Int      @default(0)
  sentAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([merchantId])
  @@index([recipient])
  @@index([status])
  @@index([createdAt])
}

model IncomingWebhook {
  id              String   @id @default(uuid())
  eventId         String   @unique
  merchantId      String?
  platform        String
  provider        String?
  orderId         String?
  productId       String?
  productName     String?
  productSku      String?
  productCategory String?
  customerName    String?
  customerEmail   String?
  quantity        Int?
  amount          Decimal?
  currency        String?
  paymentStatus   String?
  orderStatus     String?
  processingStatus String  @default("PENDING")
  rawPayload      String
  rawHeaders      String?
  signature       String?
  sourceIp        String?
  responseCode    Int?
  retryCount      Int      @default(0)
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([eventId])
  @@index([merchantId])
  @@index([platform])
  @@index([processingStatus])
  @@index([orderId])
  @@index([productId])
  @@index([customerEmail])
  @@index([createdAt])
}

model AdminWallet {
  id            String   @id @default(uuid())
  balance       Decimal  @default(0)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  AdminWalletTransaction[]
  fundingRequests FundingRequest[] @relation("AdminWalletFundingRequests")
}

model AdminWalletTransaction {
  id            String   @id @default(uuid())
  adminWalletId String
  type          String   // CREDIT | DEBIT
  amount        Decimal
  balanceAfter  Decimal
  referenceId   String?  // fulfillment ID or funding request ID
  source        String   // FULFILLMENT | FUNDING | MANUAL | REFUND
  description   String?
  createdAt     DateTime @default(now())

  adminWallet   AdminWallet @relation(fields: [adminWalletId], references: [id], onDelete: Cascade)

  @@index([adminWalletId])
  @@index([referenceId])
  @@index([source])
  @@index([createdAt])
}

model FundingRequest {
  id            String   @id @default(uuid())
  merchantId    String
  adminWalletId String
  amount        Decimal
  currency      String   @default("USD")
  note          String?
  screenshot    String?  // base64 data-URL of the payment proof (EasyPaisa/bank receipt)
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote     String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant      Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  adminWallet   AdminWallet @relation("AdminWalletFundingRequests", fields: [adminWalletId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([adminWalletId])
  @@index([status])
  @@index([createdAt])
}

model SupportMessage {
  id              String   @id @default(uuid())
  merchantId      String
  senderRole      String   // MERCHANT | ADMIN
  senderName      String?
  body            String?
  image           String?  // base64 data-URL attachment (payment proof, screenshots)
  fundingRequestId String? // links a chat thread to a funding request when applicable
  readByAdmin     Boolean  @default(false)
  readByMerchant  Boolean  @default(false)
  createdAt       DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@index([readByAdmin])
}

// Simple key/value platform flags (e.g. EMERGENCY_STOP)
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Cost tracking for each bulk code upload batch
model CodeBatch {
  id             String   @id // same nanoid stored on each CodeItem.batchId
  denominationId String
  quantity       Int
  supplierId     String?
  costPerCode    Decimal?
  currency       String   @default("USD")
  note           String?
  createdBy      String?
  createdAt      DateTime @default(now())

  denomination Denomination @relation(fields: [denominationId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])

  @@index([denominationId])
  @@index([createdAt])
}

model ConnectedProduct {
  id              String   @id @default(uuid())
  merchantId      String
  platform        String
  provider        String?
  platformProductId String?
  platformSku     String?
  name            String
  sku             String?
  category        String?
  imageUrl        String?
  price           Decimal?
  currency        String?
  stock           Int      @default(0)
  status          String   @default("ACTIVE")
  inventorySource String?  @default("DCV")
  dcvProductId    String?
  dcvDenominationId String?
  dcvVariantId    String?
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  dcvProduct    Product?     @relation("ConnectedProductDcvProduct", fields: [dcvProductId], references: [id], onDelete: SetNull)

  @@unique([merchantId, platform, platformProductId])
  @@unique([merchantId, platform, platformSku])
  @@index([merchantId])
  @@index([platform])
  @@index([status])
  @@index([dcvProductId])
}

model PaymentRecord {
  id                    String    @id @default(uuid())
  customerId            String?
  merchantId            String?
  customerOrderId       String?  @unique
  stripeCheckoutSessionId String?  @unique
  stripePaymentIntentId String?  @unique
  stripeEventId         String?  @unique
  amount                Decimal
  currency              String   @default("USD")
  status                String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | CANCELED | REFUNDED
  paymentType           String   // CUSTOMER_PURCHASE | MERCHANT_WALLET_FUNDING
  description           String?
  metadata              String?
  refundAmount          Decimal?
  refundReason          String?
  refundedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  paidAt                DateTime?

  customerOrder         CustomerOrder? @relation(fields: [customerOrderId], references: [id])

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
  @@index([paymentType])
  @@index([createdAt])
}

model CustomerOrder {
  id              String   @id @default(uuid())
  customerId      String?
  customerEmail   String
  customerName    String?
  productId       String
  denominationId  String?
  amount          Decimal
  currency        String   @default("USD")
  status          String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | FULFILLED | FAILED | CANCELED
  fulfillmentId   String?
  revealToken     String?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payment         PaymentRecord?

  @@index([customerId])
  @@index([customerEmail])
  @@index([status])
  @@index([productId])
  @@index([createdAt])
}
