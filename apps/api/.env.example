# ─── Environment ───
NODE_ENV=development

# ─── Server ───
PORT=3000
APP_URL=http://localhost:3000

# ─── CORS ───
# Comma-separated list of allowed origins in production (no wildcard, no localhost).
# Example: https://admin.yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=*

# ─── Database (PostgreSQL required in production) ───
DATABASE_URL=postgresql://user:password@localhost:5432/codevault

# ─── Redis (required in production) ───
REDIS_URL=redis://localhost:6379

# ─── JWT ───
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption (AES-256-GCM key for code storage) ───
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Admin bootstrap (creates/updates the first admin user on boot) ───
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Super Admin

# ─── Email provider: "sendgrid" or "resend" ───
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─── SMTP (if using a generic SMTP transport instead of a provider API) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Stripe (if enabled) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Rate limiting ───
RATE_LIMIT_PER_MINUTE=120
HMAC_TIMESTAMP_WINDOW_MS=300000

# ─── Idempotency / reservation TTLs ───
IDEMPOTENCY_KEY_TTL_MS=86400000
IDEMPOTENCY_KEY_TTL_HOURS=24
RESERVATION_TTL_MINUTES=15
