{
  "name": "digital-code-vault",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx concurrently \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:admin": "cd apps/admin && npm run dev",
    "dev:merchant": "cd apps/merchant && npm run dev",
    "dev:portal": "cd apps/portal && npm run dev",
    "build:shared": "cd packages/shared && npm run build",
    "build:api": "cd apps/api && npm run build",
    "build:admin": "cd apps/admin && npm run build",
    "build:merchant": "cd apps/merchant && npm run build",
    "build:portal": "cd apps/portal && npm run build",
    "build": "npm run build:shared && npm run build:api && npm run build:admin && npm run build:merchant && npm run build:portal",
    "db:migrate": "cd apps/api && npm run prisma:migrate",
    "db:migrate:deploy": "cd apps/api && npm run prisma:migrate:deploy",
    "db:generate": "cd apps/api && npm run prisma:generate",
    "db:seed": "cd apps/api && npm run seed",
    "db:studio": "cd apps/api && npm run prisma:set-provider && npx prisma studio",
    "deploy:prepare": "powershell -ExecutionPolicy Bypass -File prepare-deploy.ps1",
    "deploy:build": "bash apps/api/deploy-build.sh"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "concurrently": "^8.2.2",
    "csstype": "^3.1.3",
    "typescript": "^5.4.0"
  }
}
